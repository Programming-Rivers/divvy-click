""" Bazel module for DivvyClick, a keyboard-driven mouse emulation utility for macOS """

module(
    name = "divvy-click",
    version = "0.7.next",
)

bazel_dep(
    name = "aspect_rules_lint",
    version = "2.8.0",
    dev_dependency = True,
)
bazel_dep(
    name = "buildifier_prebuilt",
    version = "8.5.1.4",
    dev_dependency = True,
)

# Not required by the project,
# but the linter fails without it.
# It is a bug in the linter for sure.
bazel_dep(
    name = "rules_go",
    version = "0.63.0",
    dev_dependency = True,
)
bazel_dep(
    name = "rules_shell",
    version = "0.8.0",
    dev_dependency = True,
)

bazel_dep(
    name = "apple_support",
    version = "2.8.1",
)
bazel_dep(
    name = "rules_apple",
    version = "5.0.0-rc4",
)
bazel_dep(
    name = "rules_swift",
    version = "4.0.0-rc6",
)
bazel_dep(name = "llvm", version = "0.8.19")

llvm = use_extension("@llvm//extensions:llvm.bzl", "llvm")
use_repo(llvm, "llvm-project")

register_toolchains("@llvm-project//:all")
